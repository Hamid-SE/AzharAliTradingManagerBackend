# Database (required for dashboard, clients, quotations, invoices)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/azhar_trading?retryWrites=true&w=majority

# Must match frontend AUTH_SECRET (session cookie JWT)
AUTH_SECRET=generate-a-long-random-string-here

# First admin (copied to MongoDB on first login; must match frontend/.env.local)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Administrator

# Server
BACKEND_PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# Optional: AI-assisted quotation drafting (Google Gemini)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite